{
  "name": "@vigil/mcp-server",
  "version": "0.1.0",
  "description": "Vigil MCP Server — give AI agents onchain safety tools",
  "bin": {
    "vigil-mcp": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --ext .ts",
    "fmt": "prettier --write src",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@vigil/sdk-ts": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
