# ── Service config ──────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=info

# ── Ports (override per-service if running all locally) ──────────────────────
PORT=8080

# ── Postgres ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://vigil:vigil@localhost:5432/vigil?sslmode=disable

# ── ClickHouse ───────────────────────────────────────────────────────────────
CLICKHOUSE_URL=clickhouse://localhost:9000/vigil

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true

# ── Timeouts ─────────────────────────────────────────────────────────────────
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s

# ── Ingest service ───────────────────────────────────────────────────────────
INGEST_MAX_PAYLOAD_BYTES=4194304
INGEST_MAX_QUEUE_LEN=100000
INGEST_SAMPLE_RATE=1.0
CHAIN_1_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<your-alchemy-key>
CHAIN_8453_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<your-alchemy-key>
CHAIN_42161_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<your-alchemy-key>

# ── Telemetry opt-out ────────────────────────────────────────────────────────
# VIGIL_TELEMETRY=0
# DO_NOT_TRACK=1

# ── API service ──────────────────────────────────────────────────────────────
FLIGHTCHECK_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Stripe billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

# ── Insights service ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
INSIGHTS_PROJECT_ID=
INSIGHTS_SCAN_INTERVAL=5m

# ── Alerts service ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
ALERT_SIGNING_KEY=
