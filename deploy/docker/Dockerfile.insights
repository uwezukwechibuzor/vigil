# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS builder
WORKDIR /src

# Copy workspace and module files first for layer caching
COPY go.work go.work.sum* ./
COPY services/internal/platform/go.mod services/internal/platform/go.sum ./services/internal/platform/
COPY services/insights/go.mod services/insights/go.sum* ./services/insights/

RUN --mount=type=cache,target=/root/.cache/go \
    --mount=type=cache,target=/go/pkg/mod \
    cd services/insights && go mod download

COPY services/internal/platform ./services/internal/platform
COPY services/insights ./services/insights

RUN --mount=type=cache,target=/root/.cache/go \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/vigil-insights \
      ./services/insights/cmd/insights

# --- runtime ----------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/vigil-insights /vigil-insights
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/vigil-insights"]
